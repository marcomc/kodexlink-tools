# Example content for ~/.config/kodexlink-tools/relay.env.
# Generate the real local file with:
#   make install PUBLIC_URL=https://machine-name.tailnet-name.ts.net

COMPOSE_PROJECT_NAME=kodexlink-relay
KODEXLINK_TOOLS_DIR=/path/to/kodexlink-tools
KODEXLINK_RELAY_REPO=/path/to/kodexlink-mobile-relay

# This value is embedded in the QR pairing payload and stored by the mobile app.
# For Tailscale Serve, use the HTTPS MagicDNS URL. Do not include the local
# Docker port unless the public reverse proxy really exposes that port.
KODEXLINK_RELAY_PUBLIC_BASE_URL=https://machine-name.tailnet-name.ts.net

# This is only the local Mac port that Docker binds to 127.0.0.1.
# Tailscale Serve proxies HTTPS port 443 to this local port.
KODEXLINK_RELAY_HOST_PORT=8787

KODEXLINK_POSTGRES_DB=codex_mobile
KODEXLINK_POSTGRES_USER=kodexlink
KODEXLINK_POSTGRES_PASSWORD=change-me-generate-with-init-env
